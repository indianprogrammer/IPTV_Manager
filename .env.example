# Copy this file to .env and adjust the values. Real environment variables
# always take precedence over values set in .env.

# Bind address for all three servers. Use 0.0.0.0 to expose on the LAN.
IPTV_HOST=127.0.0.1

# Web UI (administration interface)
IPTV_PORT=8000

# Playlist feed (cached M3U with every enabled channel)
IPTV_PLAYLIST_PORT=8001

# Clear-only feed (M3U without DRM-configured channels)
IPTV_CLEAR_PORT=8002

# PHP binary used by the launcher (defaults to whatever `php` resolves to)
#PHP_BIN=php
